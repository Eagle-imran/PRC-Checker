<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Property Cards Batch Dashboard — {{ village }}</title>
    <style>
        {% include "styles.css.j2" %}
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: var(--bg-main); color: var(--text-main); display: flex; height: 100vh; overflow: hidden; }
        
        .sidebar { width: 320px; background: var(--bg-card); border-right: 1px solid var(--border-color); display: flex; flex-direction: column; }
        .sidebar-header { padding: 1.25rem; border-bottom: 1px solid var(--border-color); }
        .sidebar-header h1 { font-size: 1.15rem; color: var(--accent-blue); font-weight: 700; margin-bottom: 0.25rem; }
        .sidebar-header p { font-size: 0.8rem; color: var(--text-muted); }
        .plot-list { flex: 1; overflow-y: auto; padding: 0.75rem; }
        .plot-card { padding: 1rem; border-radius: 8px; background: var(--bg-main); margin-bottom: 0.5rem; cursor: pointer; border: 1px solid var(--border-color); transition: all 0.15s; }
        .plot-card:hover, .plot-card.active { border-color: var(--accent-blue); background: var(--bg-card); }
        .plot-card-title { font-weight: 600; font-size: 0.95rem; display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem; }
        .plot-card-meta { font-size: 0.8rem; color: var(--text-muted); }

        .main { flex: 1; display: flex; flex-direction: column; background: var(--bg-main); }
        .tabs { display: flex; background: var(--bg-card); border-bottom: 1px solid var(--border-color); padding: 0 1rem; }
        .tab-btn { padding: 0.85rem 1.25rem; background: none; border: none; color: var(--text-muted); font-weight: 500; font-size: 0.9rem; cursor: pointer; border-bottom: 2px solid transparent; }
        .tab-btn.active { color: var(--accent-blue); border-bottom-color: var(--accent-blue); }
        .view-pane { flex: 1; display: none; padding: 1.5rem; overflow: auto; }
        .view-pane.active { display: block; }

        .image-frame { text-align: center; background: #000; padding: 1rem; border-radius: 8px; border: 1px solid var(--border-color); }
        .image-frame img { max-width: 100%; height: auto; border-radius: 4px; }

        .badge { padding: 3px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; }
        .badge.ok { background: var(--success-bg); color: var(--success-text); }
        .badge.err { background: var(--error-bg); color: var(--error-text); }
        .report-box { background: var(--bg-card); padding: 2rem; border-radius: 12px; border: 1px solid var(--border-color); max-width: 900px; margin: 0 auto; line-height: 1.6; }
        .report-box h2 { color: var(--accent-blue); margin-top: 1.5rem; margin-bottom: 0.75rem; font-size: 1.2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; }
        .report-box table { width: 100%; border-collapse: collapse; margin: 1rem 0; background: var(--bg-main); border-radius: 6px; overflow: hidden; }
        .report-box th, .report-box td { padding: 10px 14px; text-align: left; border-bottom: 1px solid var(--border-color); font-size: 0.9rem; }
        .report-box th { background: var(--border-color); color: var(--text-main); }
        .alert { padding: 1rem; border-radius: 6px; margin: 1rem 0; font-size: 0.9rem; }
        .alert.warning { background: var(--warning-bg); border: 1px solid var(--warning-border); color: var(--warning-text); }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-header">
            <h1>Property Cards Batch</h1>
            <p>Village: {{ village }} | District: {{ district }} ({{ results|length }} Plots)</p>
        </div>
        <div class="plot-list" id="plotList"></div>
    </div>
    <div class="main">
        <div class="tabs">
            <button class="tab-btn active" onclick="switchTab('image')">🖼️ Card Image</button>
            <button class="tab-btn" onclick="switchTab('report')">📋 Title Audit Report</button>
            <button class="tab-btn" onclick="switchTab('html')">📄 Clean HTML</button>
        </div>
        <div class="view-pane active" id="pane-image">
            <div class="image-frame">
                <img id="imgViewer" src="" alt="Select a plot from sidebar" />
            </div>
        </div>
        <div class="view-pane" id="pane-report">
            <div class="report-box" id="reportViewer">Select a plot to view its Title Audit Report.</div>
        </div>
        <div class="view-pane" id="pane-html">
            <iframe id="htmlViewer" style="width: 100%; height: 100%; border: 1px solid var(--border-color); border-radius: 8px; background: #fff;"></iframe>
        </div>
    </div>

    <script>
        const plots = {{ cards_js_json|safe }};
        let activeIndex = 0;

        function renderSidebar() {
            const list = document.getElementById('plotList');
            list.innerHTML = plots.map((p, i) => `
                <div class="plot-card ${i === activeIndex ? 'active' : ''}" onclick="selectPlot(${i})">
                    <div class="plot-card-title">
                        <span>CTS ${p.cts}</span>
                        <span class="badge ${p.status === 'ok' ? 'ok' : 'err'}">${p.status}</span>
                    </div>
                    <div class="plot-card-meta">${p.file_jpg || 'Failed'}</div>
                </div>
            `).join('');
        }

        function selectPlot(index) {
            activeIndex = index;
            renderSidebar();
            const p = plots[index];
            document.getElementById('imgViewer').src = p.file_jpg || '';
            document.getElementById('htmlViewer').src = p.file_html || '';
            
            document.getElementById('reportViewer').innerHTML = `
                <h2>Title Audit Summary — CTS ${p.cts}</h2>
                <table>
                    <tr><th>Attribute</th><th>Record Value</th></tr>
                    <tr><td><strong>CTS Number</strong></td><td>CTS ${p.cts}</td></tr>
                    <tr><td><strong>Status</strong></td><td>${p.status}</td></tr>
                    <tr><td><strong>JPEG Output</strong></td><td><a href="${p.file_jpg || ''}" target="_blank" style="color:var(--accent-blue)">${p.file_jpg || ''}</a></td></tr>
                    <tr><td><strong>Markdown Report</strong></td><td><a href="${p.file_report || ''}" target="_blank" style="color:var(--accent-blue)">${p.file_report || ''}</a></td></tr>
                </table>
            `;
        }

        function switchTab(tabName) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.view-pane').forEach(p => p.classList.remove('active'));
            event.target.classList.add('active');
            document.getElementById('pane-' + tabName).classList.add('active');
        }

        if (plots.length > 0) selectPlot(0);
    </script>
</body>
</html>
